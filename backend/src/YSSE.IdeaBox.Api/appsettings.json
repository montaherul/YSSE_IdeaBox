{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "YSSE.IdeaBox",
    "Audience": "YSSE.IdeaBox.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Guest": {
    "ReviewCookieDays": 365
  },
  "Storage": {
    "Root": "storage/uploads"
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "YSSE Idea Box"
  },
  "Sms": {
    "Enabled": false,
    "EndpointUrl": "",
    "ApiKey": "",
    "ApiKeyHeader": "Authorization",
    "From": ""
  },
  "Redis": {
    "ConnectionString": ""
  }
}
